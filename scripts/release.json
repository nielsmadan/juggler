{
  "branch": "main",
  "version_parts": 3,
  "initial_version": "0.1.0",
  "sign": true,
  "preflight": [
    [
      "python3",
      "scripts/hooklinesinker.py",
      "stage",
      "--published"
    ],
    [
      "just",
      "check"
    ]
  ],
  "pins": [
    "hooklinesinker"
  ],
  "tools": [
    "git",
    "gh",
    "python3",
    "just",
    "xcodebuild",
    "swiftformat",
    "swiftlint",
    "periphery"
  ],
  "stages": [
    {
      "files": [
        "Juggler.xcodeproj/project.pbxproj",
        "juggler/Views/SettingsView.swift"
      ],
      "commands": [
        [
          "python3",
          "scripts/prepare_release.py",
          "version",
          "{version}"
        ],
        [
          "python3",
          "scripts/prepare_release.py",
          "revision",
          "{revision}"
        ]
      ],
      "message": "chore: release {version}"
    }
  ],
  "name": "Juggler",
  "repository": "nielsmadan/juggler",
  "workflow": "release.yml",
  "success_message": "Signed and notarized GitHub release, updater feed and Homebrew cask"
}
